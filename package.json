    "./data/ascii.json": "./web/font/ascii-outlines.json",
    "./data/alpha.json": "./web/font/alpha-centerlines.json"
  },
  "scripts": {"test": "node verify-library.mjs && node verify-glyph-morph.mjs"}
}
